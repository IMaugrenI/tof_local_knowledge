POSTGRES_DB=tof_local_knowledge
POSTGRES_USER=tof_local_knowledge
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://tof_local_knowledge:local_dev_password@postgres:5432/tof_local_knowledge
TZ=Europe/Berlin
BIND_HOST=127.0.0.1

AUTH_API_PORT=8101
CATALOG_API_PORT=8102
INGEST_API_PORT=8103
EXTRACTOR_API_PORT=8104
SEARCH_API_PORT=8105
QA_API_PORT=8106
OPENWEBUI_PORT=3000
OLLAMA_PORT=11434

LOCAL_SOURCE_ROOT_1=./demo/source_1
DERIVED_STORAGE_PATH=./storage/derived
PREVIEW_STORAGE_PATH=./storage/previews
EXPORT_STORAGE_PATH=./storage/exports

ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OLLAMA_BASE_URL=http://ollama:11434
ENABLE_OLLAMA=false
# Optional local-only QA relevance model. Empty = deterministic FTS ranking.
QA_OLLAMA_MODEL=
# Optional 768D embedding model already installed in local Ollama, e.g. nomic-embed-text.
# No model download or semantic search when left empty.
KNOWLEDGE_EMBED_MODEL=
ENABLE_OPEN_WEBUI=false
